# Copy the relevant parts into Streamlit Cloud → App → Settings → Secrets
# (or into a local .streamlit/secrets.toml, which is git-ignored).
#
# There are two independent features here:
#   1. [database]  -> persistent storage (config + daily logs)
#   2. [auth]      -> multi-user sign-in (each account gets isolated data)
#
# You can enable either or both. With neither, the app runs as a single-user
# local app backed by files (great for development).


# ---------------------------------------------------------------------------
# 1) Persistent storage. Get a free Postgres URL from https://neon.tech.
#    SQLAlchemy accepts the "postgresql://" form directly.
# ---------------------------------------------------------------------------
[database]
url = "postgresql://user:password@host/dbname?sslmode=require"


# ---------------------------------------------------------------------------
# 2) Multi-user sign-in via OpenID Connect (Streamlit's built-in st.login).
#    Once this section is present, every visitor must sign in and each user's
#    data is stored separately. Requires the `authlib` package (installed via
#    the `cloud` extra).
#
#    Google setup (one-time):
#      - Go to https://console.cloud.google.com/apis/credentials
#      - Create an OAuth 2.0 Client ID (type: Web application)
#      - Add an Authorized redirect URI EXACTLY matching redirect_uri below:
#          https://<your-app>.streamlit.app/oauth2callback
#        (for local dev also add: http://localhost:8501/oauth2callback)
#      - Copy the Client ID and Client secret into the fields below.
#
#    cookie_secret: any long random string (e.g. `python -c "import secrets;
#    print(secrets.token_hex(32))"`). Keep it stable and private.
# ---------------------------------------------------------------------------
[auth]
redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
