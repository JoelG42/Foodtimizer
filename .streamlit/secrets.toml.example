# Copy this into Streamlit Cloud → App → Settings → Secrets (or into a local
# .streamlit/secrets.toml, which is git-ignored). When a database URL is
# present the app stores your config and daily logs in that database instead
# of local files, so nothing is lost when the server restarts.
#
# Get a free Postgres URL from https://neon.tech (or Supabase). Neon gives you
# a string like:
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
#
# SQLAlchemy accepts that "postgresql://" form directly.

[database]
url = "postgresql://user:password@host/dbname?sslmode=require"
