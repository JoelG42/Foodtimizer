# Foodtimizer example config.
#
# Workflow:
#   1) Define your ingredients (macros per 100 g).
#   2) Define your macro targets for the day.
#   3) Define constraints per tag (e.g. breakfast caps at 400 kcal).
#   4) Compile a `meal_library` of your meals, each tagged with what slot
#      it fits in.
#   5) Either set a default `day:` plan here, or override at the CLI with
#      --breakfast / --lunch / --dinner / --snack flags.

# Global defaults applied to every (slot, ingredient) variable.
# Bound fields declared directly on an ingredient and per-meal ingredient
# specs in `meal_library` can tighten these; effective min is the max of all
# applicable lower bounds and effective max is the min of all upper bounds.
defaults:
  per_meal_min: 5      # every listed ingredient must contribute at least 5 g
  per_meal_max: 320    # global ceiling; tighten for specific items below
  main_min: 100         # default min grams for ingredients labelled `main`
  # Soft pull toward each meal's per-ingredient `anchor` (typical recipe
  # amount, in grams). Anchors are L1-penalised, so they bend when macro
  # targets demand it. Keep this small relative to macro weights below.
  anchor_weight: 0.05

ingredients:
  # Each ingredient holds its macros (per 100 g) plus any real-life
  # constraints right next to them. Recognised bound keys:
  #   - step                    : quantize gram amount (integer multiples)
  #   - serving                 : typical per-meal minimum (alias for per_meal_min)
  #   - per_meal_min/max        : per-meal grammage bounds
  #   - per_meal_min/max_units  : same, expressed as multiples of `step`
  #   - total_min/max[_units]   : daily bounds (across all slots)

  # --- Protein sources ---
  ground_beef:    { kcal: 127, protein: 21.0, carbs: 0.0, fat: 4.5, fibre: 0.0, per_meal_max: 200 }       # 400 g pack = 2 portions
  ground_beef_16%: { kcal: 220, protein: 19.0, carbs: 0.0, fat: 16, fibre: 0.0, per_meal_max: 200 }       # 400 g pack = 2 portions
  chicken_breast: { kcal: 109, protein: 25.0, carbs: 0.0, fat: 1.0,  fibre: 0.0,
                    per_meal_max: 150 }       # 450 g pack = 3 portions
  sushi_salmon:   { kcal: 161, protein: 21.4, carbs: 0.0, fat: 8.4, fibre: 0.0, step: 130,serving: 130, per_meal_max: 150 }
  shrimp:         { kcal: 65, protein: 15.0, carbs: 0.0, fat: 0.5, fibre: 0.0, serving: 150, per_meal_max: 150 }
  whey_protein:  { kcal: 387, protein: 70.0, carbs: 8.0,  fat: 7.4,  fibre: 2.4, total_max: 60 }
  chicken_wings: { kcal: 189, protein: 18.0, carbs: 0.0, fat: 13.0,  fibre: 0.0}


  # --- Dairy sources ---
  eggs:          { kcal: 155, protein: 13.0, carbs: 1.1,  fat: 11.0, fibre: 0.0,
                   step: 55, per_meal_max_units: 4, total_max_units: 4 }
  milk_3.9%:     { kcal: 68,  protein: 3.2,  carbs: 4.9,  fat: 3.9,  fibre: 0.0, serving: 100, per_meal_max: 250 }
  greek_yogurt:  { kcal: 56,  protein: 8.5,  carbs: 5.5,  fat: 0.0,  fibre: 0.0, serving: 50, per_meal_max: 250 }      
  feta_cheese:    { kcal: 277, protein: 17.0, carbs: 0.2, fat: 23.0, fibre: 0.0, serving: 50 , per_meal_max: 150}
  parmesan_cheese: { kcal: 402, protein: 33.0, carbs: 1.3, fat: 30.0, fibre: 0.0, serving: 50 , per_meal_max: 150}
  sirrene: { kcal: 316, protein: 17.1, carbs: 1.1, fat: 27.0, fibre: 0.0}
               


  # --- Carb sources ---
  oats:          { kcal: 381, protein: 13,   carbs: 63,   fat: 7,  fibre: 6,   serving: 50 }
  rice_white:     { kcal: 349, protein: 7,   carbs: 78.0, fat: 0.8, fibre: 0.0, serving: 80, per_meal_max: 150 }
  pasta:          { kcal: 356, protein: 14.5,  carbs: 69.5,   fat: 1.6, fibre: 2.9, serving: 80, per_meal_max: 150 }
  gnocchi:        { kcal: 154, protein: 4.0, carbs: 33.0, fat: 0.0, fibre: 0.0, serving: 120, per_meal_max: 200 }
  tortilla:       { kcal: 299, protein: 9.1, carbs: 53.0, fat: 5.2, fibre: 1.6,
                    step: 60, per_meal_min_units: 1, per_meal_max_units: 1}
  sonnen_brot: { kcal: 280, protein: 8.2, carbs: 47.0, fat: 3.0, fibre: 0.0, serving: 50, per_meal_max: 150}

  # --- Fat sources --- 
  peanut_butter:  { kcal: 613, protein: 25.0, carbs: 17.0, fat: 48.0, fibre: 4.5, serving: 10, per_meal_max: 40 }
  butter:        { kcal: 748, protein: 0.0, carbs: 0.0, fat: 81.0, fibre: 0.0, per_meal_max: 10 }
  olive_oil:     { kcal: 828, protein: 0.0, carbs: 0.0, fat: 92.0, fibre: 0.0, per_meal_max: 10 }


 # --- Fruits ---
  banana:        { kcal: 89,  protein: 1.1,  carbs: 23.0, fat: 0.3,  fibre: 2.6, serving: 80, per_meal_max: 110 }
  mango:          { kcal: 64,  protein: 0.6, carbs: 14.0, fat: 0.0, fibre: 1.6, serving: 60, per_meal_max: 150 }
  avocado:        { kcal: 160, protein: 2, carbs: 8.5,  fat: 14.5, fibre: 7.0, serving: 60, per_meal_max: 100 }
  green_apple:    { kcal: 52,  protein: 0.3, carbs: 14.0, fat: 0.2, fibre: 2.4, serving: 80, per_meal_max: 100 }
  blueberries:    { kcal: 52,  protein: 1.7, carbs: 17.0, fat: 0.3,  fibre: 2.4, serving: 80, per_meal_max: 100 }
  watermelon:     { kcal: 30,  protein: 0.6, carbs: 7.6,  fat: 0.2,  fibre: 0.4, serving: 100, per_meal_max: 150 }


 # --- Vegetables --- 
  bell_pepper:    { kcal: 26,  protein: 1.1, carbs: 6.2,  fat: 0.2,  fibre: 1.4, serving: 60, per_meal_max: 100 }
  tomato:         { kcal: 18,  protein: 0.9, carbs: 3.9,  fat: 0.2,  fibre: 1.2, serving: 60, per_meal_max: 150 }
  onion:          { kcal: 40,  protein: 1.1, carbs: 9.3,  fat: 0.1,  fibre: 1.7, serving: 40, per_meal_max: 80 }
  carrots:        { kcal: 35,  protein: 1.0, carbs: 9.6,  fat: 0.2,  fibre: 2.8, serving: 60, per_meal_max: 120 }
  garlic:         { kcal: 149, protein: 6.0, carbs: 28.0, fat: 0.5,  fibre: 3.6, per_meal_max: 15 }
  cucumber:       { kcal: 16,  protein: 0.7, carbs: 3.6,  fat: 0.1,  fibre: 0.9, serving: 60, per_meal_max: 200 }
  broccoli:       { kcal: 31,  protein: 3, carbs: 2.4,  fat: 0.4,  fibre: 3, serving: 60, per_meal_max: 120 }

  # --- Sauces ---
  vinegar:        { kcal: 19,  protein: 0.0, carbs: 0.0, fat: 0.0, fibre: 0.0, serving: 10, per_meal_max: 15 }
  tomato_sauce:   { kcal: 21,  protein: 1.2, carbs: 3.3,  fat: 0.5,  fibre: 0.9, serving: 100, per_meal_max: 200 }
  tomato_paste:   { kcal: 117,  protein: 6.2, carbs: 19,  fat: 1.2,  fibre: 2.5, serving: 10, per_meal_max: 10 }
  soy_sauce:      { kcal: 77,  protein: 1.9, carbs: 1.2,  fat: 0.1,  fibre: 0.0, per_meal_max: 20 }



 # --- Miscellaneous ---
  cacao:         { kcal: 368, protein: 20,   carbs: 9.0,  fat: 21.0, fibre: 28.0, per_meal_max: 20 }
  black_sesame_seeds: { kcal: 636, protein: 19.0, carbs: 23.0, fat: 52.0, fibre: 13.0, serving: 15, per_meal_max: 5 }


# --- Sweets ---



# --- Macro targets ---
targets:
  kcal:    { upper: 1800}
  protein: { value: 130, weight: 25.0 }   # protein gets matched tightly
  carbs:   { value: 180, weight: 25.0 }    # 900 kcal / 4 kcal·g⁻¹ = 225 g
  fat:     { value: 60, weight: 50.0 }
  fibre:   { lower: 25 }                   # min 25 g, no upper, no penalty




tag_constraints:
  breakfast:    { kcal_max: 750 }
  # NOTE: combine both floors in ONE mapping. Writing `macro_min` twice silently
  # drops the first one because YAML keeps the last duplicate key.
  lunch_dinner: { kcal_max: 750, macro_min: { carbs: 30, protein: 25 } }
  snack:        { kcal_max: 300 }

meal_library:
  # Per-ingredient mapping values supported:
  #   <number>          -> anchor (typical grams for this meal)
  #   main / aux        -> role flag (main hits defaults.main_min)
  #   { anchor: N, main: true, min: N, max: N }
  # Anchors are soft pulls — the optimizer will deviate to hit macros.
  # Use min/max for hard limits, step on the ingredient for quantization.

  oats_breakfast:
    tag: breakfast
    ingredients:
      oats:          50
      banana:        80
      whey_protein:  15
      milk_3.9%:     {anchor: 100, max: 200}
      cacao:         5
      peanut_butter: 10

  banana_omlettte:
    tag: breakfast
    ingredients:
      eggs:          165   # ~2 eggs
      banana:       100
      peanut_butter: 10
      milk_3.9%:     60
      butter:         5

  banana_bread:
    tag: breakfast
    ingredients:
      eggs:          110   # ~2 eggs
      banana:       100
      whey_protein:  15
      cacao:         5
      milk_3.9%:     30
      peanut_butter: 10




  greek_salad:
    tag: lunch_dinner
    ingredients:
      cucumber: { anchor: 100, min: 150 }
      tomato: { anchor: 100, min: 150 }
      onion: 50
      olive_oil: { anchor: 10, min: 10 }
      feta_cheese: 50
      vinegar: 5

  gnocchi_bolognese:
    tag: lunch_dinner
    ingredients:
      gnocchi:      150
      ground_beef:  { anchor: 100, main: true }
      tomato_sauce: 100
      carrots:       80
      onion:         50
      olive_oil:   2
      tomato_paste:  10
      garlic:         5
      butter:         5




  pasta_bolognese:
    tag: lunch_dinner
    ingredients:
      pasta: 100
      ground_beef: { anchor: 100, main: true }
      tomato_sauce: { anchor: 150, min: 150 }
      carrots:       80
      onion:         50
      olive_oil:   2
      garlic:         5
      tomato_paste:  8
      butter: 5



  chicken_wrap:
    tag: lunch_dinner
    ingredients:
      chicken_breast: { anchor: 150, main: true, min: 120 }
      tortilla:       { anchor:  60, main: true }   # pinned to 1 unit by step
      avocado:        70
      tomato:         60
      onion:          30
      garlic:          5
      olive_oil:     2

  beef_wrap:
    tag: lunch_dinner
    ingredients:
      ground_beef: { anchor: 100, main: true, max: 120 }
      tortilla: { anchor: 60, main: true }
      greek_yogurt: 50
      feta_cheese: 15
      bell_pepper: 100
      onion: 50
      garlic: 5
      olive_oil: 2







  yoghurt_snack:
    tag: snack
    ingredients:
      greek_yogurt: { anchor: 150, main: true, min: 120 }
      blueberries:  60
      cacao:          10
      whey_protein: 10
      peanut_butter: 5


  frozen_yoghurt:
    tag: snack
    ingredients:
      greek_yogurt: { anchor: 150, main: true, min: 150 }
      cacao:          10
      whey_protein: 10
      peanut_butter: 5



 


# `ingredient_bounds:` is no longer needed for typical usage — bound info
# lives next to each ingredient above. You *can* still add an
# `ingredient_bounds:` section here to override any field on a per-ingredient
# basis (it wins per field), but for this example everything is inline.

# Default day plan — used if you don't override on the CLI.
day:
  breakfast: banana_bread
  lunch:     chicken_wrap
  dinner:    gnocchi_bolognese
  snack:     yoghurt_snack
